{
  "name": "@noctcore/harness",
  "version": "0.5.0",
  "type": "module",
  "sideEffects": false,
  "description": "Portable Structure-Lock runner and lint-meta engine, plus generic lint-meta rules and pinned-tool runners. Enforces a repo's checks in any CI, with no Nightcore install.",
  "license": "MIT",
  "homepage": "https://github.com/noctcore/nightcore/tree/main/packages/harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noctcore/nightcore.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/noctcore/nightcore/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harness": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js",
      "require": "./dist/rules.cjs"
    },
    "./pinned-tools": {
      "types": "./dist/pinned-tools.d.ts",
      "import": "./dist/pinned-tools.js",
      "require": "./dist/pinned-tools.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts src/rules.ts src/pinned-tools.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
